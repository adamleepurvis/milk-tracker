# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API) and the VAPID keypair (see supabase/functions/six-month-alert/README.md).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shared household passcode. This is baked into the client bundle (NEXT_PUBLIC_*),
# so it is a light deterrent for the app's UI, not a real security boundary -- see
# the note at the top of supabase/migrations/0001_init.sql.
NEXT_PUBLIC_HOUSEHOLD_PASSCODE=change-me

# Public half of the VAPID keypair used for Web Push (the private half is a Supabase
# Edge Function secret, never exposed to the client). Generate both with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
